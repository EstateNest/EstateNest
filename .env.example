# EstateNest Environment Variables
# Copy this file to .env.local and fill in the values

# ==========================================
# GOOGLE ANALYTICS 4
# ==========================================
# Get your GA4 Measurement ID from Google Analytics
# Admin → Data Streams → Choose your stream → Measurement ID
# Format: G-XXXXXXXXXX
VITE_PUBLIC_GA_ID=G-XXXXXXXXXX

# ==========================================
# EMAIL SERVICE OPTIONS
# ==========================================
# Choose ONE of the following email methods:

# OPTION 1: Gmail SMTP (Use your existing Google account)
# ----------------------------------------------
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use that App Password below (NOT your regular password)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION 2: Resend (Recommended for better deliverability)
# ----------------------------------------------
# Sign up at https://resend.com (free: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ==========================================
# VERCEL CONFIGURATION
# ==========================================
# The following should be configured in Vercel Dashboard
# Settings → Environment Variables
#
# Add to all environments (Production, Preview, Development):
#
# For Gmail:
# - Name: GMAIL_USER, Value: your-email@gmail.com
# - Name: GMAIL_APP_PASSWORD, Value: xxxx xxxx xxxx xxxx
#
# For Resend:
# - Name: RESEND_API_KEY, Value: re_xxxxxxxxxxxxxxxxxxxx
#
# The system will automatically use whichever method is configured.
# Priority: Gmail → Resend (tries Gmail first)
