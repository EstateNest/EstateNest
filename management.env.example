# ===========================================
# EstateNest Lead Management System
# Environment Variables Template
# ===========================================

# Copy this file to .env.local and fill in the values

# ===========================================
# SUPABASE / DATABASE
# ===========================================
# Server-only Vercel Functions configuration
# The Vite browser app calls same-origin /api routes and receives no Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key-here

# ===========================================
# AUTHENTICATION
# ===========================================
# Secret key for JWT/session signing - generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-key-here
# Session cookie name
SESSION_COOKIE_NAME=estatenest_session
# Session expiry in days
SESSION_EXPIRY_DAYS=7

# ===========================================
# INITIAL ADMIN USER
# ===========================================
# Configure these only through a private environment file or Vercel.
INITIAL_ADMIN_USERNAME=replace-with-private-admin-username
INITIAL_ADMIN_EMAIL=replace-with-private-admin-email
INITIAL_ADMIN_PASSWORD=replace-with-a-random-password-at-least-16-characters

# ===========================================
# GMAIL (primary lead notification provider)
# ===========================================
GMAIL_USER=hello@estatenest.ca
GMAIL_APP_PASSWORD=replace-with-a-google-app-password

# ===========================================
# RESEND EMAIL (optional fallback)
# ===========================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@estatenest.ca
EMAIL_FROM_NAME=Estate Nest Inc.

# Lead notification recipients
LEAD_NOTIFICATION_EMAIL_1=hello@estatenest.ca
LEAD_NOTIFICATION_EMAIL_2=kanwar@estatenest.ca

# ===========================================
# CLIENT-SIDE VITE VARIABLES
# ===========================================
# Do not place passwords, Supabase secret keys, or other secrets in VITE_* variables.
# Estate Nest analytics IDs are public and currently configured in public/analytics.js.

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://www.estatenest.ca,https://estatenest.ca

# ===========================================
# RATE LIMITING
# ===========================================
# Max login attempts per IP per hour
MAX_LOGIN_ATTEMPTS_PER_HOUR=5
# Rate limit window in seconds
RATE_LIMIT_WINDOW=3600

# ===========================================
# GOOGLE CONTACTS (Future Integration)
# ===========================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# ===========================================
# MARBLISM (Future Integration)
# ===========================================
# MARBLISM_API_KEY=your-marblism-api-key
# MARBLISM_WEBHOOK_SECRET=your-marblism-webhook-secret

# ===========================================
# N8N / AUTOMATION (Future Integration)
# ===========================================
# N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/lead-events
# N8N_API_KEY=your-n8n-api-key

# ===========================================
# APPLICATION
# ===========================================
NODE_ENV=development
PORT=3001
